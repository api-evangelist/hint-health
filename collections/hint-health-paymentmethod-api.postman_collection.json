          "name": "Create Setup Intent",
          "request": {
            "name": "Create Setup Intent",
            "description": {
              "content": "The response shape depends on the practice's payment processor (`payment_processor` in the response):\n- When `rainforest`: `payment_method_config_id`, `session_key`, and `allowed_methods` are returned.\n- When `stripe`: `stripe_client_secret` is returned instead.\nThe example below shows the `rainforest` variant.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "provider",
                "patients",
                ":patient_id",
                "payment_methods",
                "setup"
