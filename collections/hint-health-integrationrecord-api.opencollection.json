{
  "opencollection": "1.0.0",
  "info": {
    "name": "Hint Health AccountAccessToken IntegrationRecord API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "IntegrationRecord",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all IntegrationRecords for a Patient",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.hint.com/api/provider/patients/:patient_id/integration_records",
            "params": [
              {
                "name": "patient_id",
                "value": "",
                "type": "path",
                "description": "Unique Patient ID"
              }
            ]
          },
          "docs": "List all IntegrationRecords for a Patient"
        }
      ]
    }
  ],
  "bundled": true
}