{
  "opencollection": "1.0.0",
  "info": {
    "name": "Hint Health AccountAccessToken User API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "User",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.hint.com/api/provider/users",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of results (default 10, min 1, max 100)"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Pagination offset (default 0)"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "Sort field (e.g. +first_name+, +-first_name+ for descending)"
              }
            ]
          },
          "docs": "List Users"
        }
      ]
    }
  ],
  "bundled": true
}